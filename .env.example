# Postgres. This is the source of truth for criteria, chunks and embeddings.
DB_NAME=scholarship_rag
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=localhost
DB_PORT=5432

# Google Gemini. Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Local models. Both run on the CPU, nothing is trained.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Langfuse tracing. Leave blank to turn tracing off.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry error reporting. Leave blank to turn it off.
SENTRY_DSN=

# Where the React page runs, for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Which provider llm.py talks to: groq or gemini.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-safeguard-20b
